{
  "apiType": "stageMode",
  "buildOption": {
    // libcadcraft_ohos.so 由 build-ohos.sh 预先产出到 entry/libs/arm64-v8a/，
    // hvigor 直接打包该目录，不走 CMake。
  },
  "buildOptionSet": [
    {
      "name": "release",
      "arkOptions": {
        "obfuscation": {
          "ruleOptions": {
            "enable": false,
            "files": ["./obfuscation-rules.txt"]
          }
        }
      }
    }
  ],
  "targets": [
    { "name": "default" },
    { "name": "ohosTest" }
  ]
}
